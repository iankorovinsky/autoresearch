NEXT_PUBLIC_SUPABASE_URL=<url>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<key>

# Canonical application origin used by authentication email links.
APP_URL=http://127.0.0.1:3000

# Enable streamed Claude chat on this machine through the Claude Agent SDK.
# It uses your local Claude Code sign-in, or ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN.
AUTORESEARCH_CLAUDE_ENABLED=0
# AUTORESEARCH_CLAUDE_MODEL=claude-opus-5-5
# AUTORESEARCH_CLAUDE_BIN=/absolute/path/to/claude

# Enable streamed Codex chat on this machine with your existing ChatGPT login.
AUTORESEARCH_CODEX_ENABLED=0
# AUTORESEARCH_CODEX_BIN=/absolute/path/to/codex
