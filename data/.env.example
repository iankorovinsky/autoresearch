# Server-only PostgreSQL connection for Prisma migrations.
# Supabase dashboard > Connect > Direct connection or Session pooler (port 5432).
# URL-encode special characters in the password. Do not use the API/publishable key.
DATABASE_URL="postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
