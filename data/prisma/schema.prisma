datasource db {
  provider = "postgresql"
}

// Supabase Auth owns users. Only these three application tables are managed here.
model Project {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String   @default(dbgenerated("auth.uid()")) @map("owner_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  threads     Thread[]

  @@index([ownerId, createdAt])
  @@map("projects")
}

model Thread {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  title     String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  messages  Message[]

  @@index([projectId, updatedAt])
  @@map("threads")
}

model Message {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId  String      @map("thread_id") @db.Uuid
  // The BEFORE INSERT trigger replaces this placeholder under a thread row lock.
  // Callers omit position; it is immutable after insertion.
  position  Int         @default(0)
  role      MessageRole
  content   String      @default("")
  metadata  Json        @default("{}") @db.JsonB
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  thread    Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([threadId, position])
  @@map("messages")
}

enum MessageRole {
  user
  assistant
  system
  tool

  @@map("message_role")
}
